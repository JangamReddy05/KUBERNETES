# ==========================================
# Kubernetes Concepts - .gitignore
# ==========================================

# Kubernetes local/config files
.kube/
*.kubeconfig
kubeconfig
kubeconfig.*
config

# Kubernetes secrets / sensitive files
*.secret.yaml
*.secret.yml
secret.yaml
secrets.yaml
*-secret.yaml
*-secrets.yaml

# Environment files
.env
.env.*
!.env.example

# Certificates and keys
*.key
*.pem
*.crt
*.csr
*.p12
*.pfx

# Logs
*.log
logs/
log/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# IDE / Editor files
.vscode/
.idea/
*.iml

# OS files
Desktop.ini

# Docker local files
.docker/
docker-data/

# Helm
.helm/
helm-charts/
*.tgz

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform sensitive variable files
secret.tfvars
secrets.tfvars

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
ENV/

# Node.js (if used in Kubernetes applications)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build / distribution files
dist/
build/
*.tar
*.zip

# Test / coverage files
.coverage
htmlcov/
.pytest_cache/

# Minikube
.minikube/

# Kind
.kind/

# Local Kubernetes generated files
*.generated.yaml
*.generated.yml

# Application runtime data
data/
tmp/
temp/

# Database local data
mongodb-data/
postgres-data/
mysql-data/

# Backup files
*.bak
*.backup
*.old

# Local documentation/build output
site/
public/
